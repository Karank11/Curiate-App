<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Curiate" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Unify surfaces -->
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <item name="android:navigationBarColor">?attr/colorPrimary</item>

        <!-- Light status bar icons on light background -->
        <item name="android:windowLightStatusBar">true</item>

        <item name="colorPrimary">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="Theme.Curiate" parent="Base.Theme.Curiate" />

    <!-- Toolbar -->
    <style name="Widget.Curiate.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="titleTextColor">?attr/colorOnPrimary</item>
        <item name="subtitleTextColor">?attr/colorOnPrimary</item>
        <item name="fontFamily">serif</item>
        <item name="navigationIconTint">?attr/colorOnPrimary</item>
        <item name="iconTint">?attr/colorOnPrimary</item>
        <item name="elevation">4dp</item>
    </style>
    <!-- Overflow menu & action menu inside toolbar -->
    <style name="ThemeOverlay.Curiate.Toolbar" parent="ThemeOverlay.Material3.Toolbar.Surface">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="colorControlNormal">?attr/colorOnSurface</item>
        <item name="colorControlHighlight">?attr/colorSecondaryContainer</item>
        <item name="android:itemTextAppearance">@style/TextAppearance.Curiate.Toolbar.Menu</item>
    </style>
    <style name="TextAppearance.Curiate.Toolbar.Menu" parent="TextAppearance.Material3.BodyMedium" />


    <!-- Bottom Navigation -->
    <style name="Widget.Curiate.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="iconTint">@color/bnv_icon_color</item>
        <item name="itemTextColor">@color/bnv_text_color</item>

        <item name="itemRippleColor">?attr/colorSecondaryContainer</item>

        <!-- Active indicator (pill behind selected item) -->
        <item name="itemActiveIndicatorStyle">@style/Widget.Curiate.BottomNav.ActiveIndicator</item>
        <item name="elevation">8dp</item>
    </style>
    <style name="Widget.Curiate.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">?attr/colorSecondaryContainer</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Material3.Corner.Full</item>
    </style>


    <style name="Theme.Curiate.BottomSheet" parent="Theme.Material3.DayNight.BottomSheetDialog">

        <!-- Options to satisfy AppCompatActivity -->
        <item name="windowNoTitle">true</item>
        <item name="windowActionBar">false</item>
        <item name="android:windowIsFloating">true</item>

        <!-- Options to style the background and behavior -->
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowSoftInputMode">adjustResize</item>

        <!-- Options to style the content -->
        <item name="bottomSheetStyle">@style/Widget.Curiate.BottomSheet.Modal</item>
    </style>
    <style name="Widget.Curiate.BottomSheet.Modal" parent="Widget.Material3.BottomSheet.Modal">
        <item name="android:background">@color/card_background</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Curiate.BottomSheetDialog</item>
    </style>
    <style name="ShapeAppearance.Curiate.BottomSheetDialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

</resources>