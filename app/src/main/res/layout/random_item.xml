<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_medium"
    android:layout_marginHorizontal="@dimen/card_margin_horizontal"
    app:cardCornerRadius="@dimen/card_corner_radius"
    app:cardElevation="@dimen/card_elevation"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_background"
        android:paddingBottom="@dimen/spacing_medium">

        <ImageView
            android:id="@+id/content_image"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="@dimen/spacing_small"
            android:layout_marginStart="@dimen/spacing_medium"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Curiate.TopRoundedImage"
            tools:src="@mipmap/curate_ic_launcher" />

        <TextView
            android:id="@+id/content_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/Curiate.TextAppearance.Title"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginStart="@dimen/spacing_medium"
            android:layout_marginEnd="@dimen/content_padding_horizontal"
            app:layout_constraintTop_toTopOf="@id/content_image"
            app:layout_constraintStart_toEndOf="@id/content_image"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Article Title or Video Title Goes Here and Can Wrap to Three Lines" />

        <TextView
            android:id="@+id/content_url"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/Curiate.TextAppearance.Meta"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="@dimen/spacing_small"
            app:layout_constraintTop_toBottomOf="@id/content_title"
            app:layout_constraintStart_toStartOf="@id/content_title"
            app:layout_constraintEnd_toEndOf="@id/content_title"
            tools:text="www.example-long-url-that-gets-truncated.com" />

        <View
            android:id="@+id/divider"
            android:layout_width="0dp"
            android:layout_height="@dimen/divider_height"
            android:background="@color/divider_color"
            android:layout_marginTop="@dimen/spacing_medium"
            app:layout_constraintStart_toStartOf="@id/content_title"
            app:layout_constraintEnd_toEndOf="@id/content_title"
            app:layout_constraintTop_toBottomOf="@id/content_url"/>

        <TextView
            android:id="@+id/content_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:background="@drawable/chip_background"
            android:paddingVertical="8dp"
            android:paddingHorizontal="14dp"
            android:textColor="@android:color/black"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@id/content_title"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="Flipkart" />

        <ImageButton
            android:id="@+id/share_button"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_share"
            app:tint="@color/icon_tint"
            app:layout_constraintEnd_toEndOf="@id/content_title"
            app:layout_constraintTop_toBottomOf="@id/divider"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>